# ~/.gitignore
# Lines starting with '#' are comments.
# Ignore patterns are processed top-down; later patterns override earlier ones.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/

# Visual Studio files
.vs/
*.VC.db
*.VC.VC.opendb

# Rider files
.idea/
*.iml

# Mac files
.DS_Store
*.AppleDouble

# Windows files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Tooling
*.exe
*.dll
*.pdb
*.lib
*.exp
*.ilk
*.msi
*.msm
*.msp

# Roslyn analyzers cache
*.cache

# Packages
packages/
*.nupkg
# except build/, which is used as an MSBuild target.
!**/packages/build/

# Cache files
*.nuget.props
*.nuget.targets

# Test results
*.trx
TestResults/

# Code coverage reports
*.coverage
*.coveragexml

# F# cache files
**/.fable/
**/.ionide/

# Node.js dependencies (if any)
node_modules/

# Env files
.env

# Rider settings backup files
*~ 
